{
  "manifest_version": 3,
  "name": "DataShield & Privacy Flow Tracker",
  "version": "1.0.0",
  "description": "Warns on sensitive data entry and tracks outgoing data flow in real time.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["page_hook.js"],
    "matches": ["<all_urls>"]
  }]
}
